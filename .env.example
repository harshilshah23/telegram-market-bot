# ==========================================
# Telegram Market Intelligence Bot Configuration
# ==========================================

# REQUIRED: Telegram Bot API Token from @BotFather on Telegram
# Get yours for free in 60 seconds:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow instructions to get your HTTP API token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OPTIONAL: Google Gemini API Key
# If set, Gemini 2.5 Flash produces enhanced AI editorial syntheses for "What Matters".
# If omitted/blank, the bot uses a built-in deterministic financial heuristic engine
# that generates high-quality market-aware briefs with $0 cost and 0 external dependencies.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# OPTIONAL: NewsAPI Key (https://newsapi.org/)
# Adds premium global news sourcing from Reuters, Bloomberg, WSJ, CNBC, CoinDesk
NEWS_API_KEY=

# Caching Configuration (in seconds)
# Keeps the bot responsive and avoids rate limits on free endpoints
CACHE_TTL_SECONDS=60
NEWS_CACHE_TTL_SECONDS=300

# Optional Server Port (for webhooks or container health checks)
PORT=3000
